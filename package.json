{
  "name": "exceldex",
  "private": true,
  "version": "0.1.0",
  "description": "A search-first quick reference for Microsoft Excel functions, shortcuts and tips.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts && node -e \"process.stdout.write(require('fs').readFileSync('eval/results/latest.md','utf8'))\"",
    "eval:freeze": "node -e \"require('fs').copyFileSync('eval/results/latest.json','eval/results/before.json');console.log('Saved eval/results/before.json')\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
